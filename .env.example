# Redis — 직접 띄운 Redis 기준. `docker compose up -d` 는 서비스 이름(redis://redis:6379)으로
# 자동 덮어쓰므로 이 값을 건드릴 필요가 없다.
# 단, redis 컨테이너만 띄우고 API 를 로컬에서 돌린다면 호스트 매핑이 6389 다 —
# `REDIS_URL=redis://localhost:6389` 로 실행하거나 아래 값을 6389 로 바꿔라.
REDIS_URL=redis://localhost:6379
DART_API_KEY=your_dart_api_key_here
LOG_LEVEL=INFO
CORS_ORIGINS=["*"]
